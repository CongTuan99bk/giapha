{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "API_ORIGIN"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_APP_DATABASE_URL",
        "TEST_PLATFORM_DATABASE_URL",
        "TEST_API_DATABASE_URL",
        "TEST_API_APP_DATABASE_URL",
        "TEST_API_PLATFORM_DATABASE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
