# Gia Phả Cội Nguồn — biến môi trường (sao chép thành .env, KHÔNG commit .env)
# Giá trị dưới đây dùng cho máy dev với infra/docker/compose.dev.yml

# Cơ sở dữ liệu
# Role chủ, chạy migration
DATABASE_URL=postgresql://coinguon:coinguon@localhost:5432/coinguon
# Role ứng dụng (bị Row-Level Security giới hạn theo dòng họ)
APP_DATABASE_URL=postgresql://coinguon_app:coinguon_app@localhost:5432/coinguon
# Role nền tảng (worker tổng hợp, super-admin) — BYPASSRLS
PLATFORM_DATABASE_URL=postgresql://coinguon_platform:coinguon_platform@localhost:5432/coinguon

# single = dùng riêng cho một dòng họ (mặc định); multi = nhiều dòng họ
CLAN_MODE=single
# API
PORT=4000
COOKIE_SECURE=false
# Web: địa chỉ API mà Next chuyển tiếp /api/v1 tới (đọc lúc build)
API_ORIGIN=http://localhost:4000
# Tài khoản quản lý cho dữ liệu mẫu GIẢ (pnpm khoi-tao / pnpm --filter @coinguon/api seed) — chỉ dùng trên máy cá nhân.
# Để trống mật khẩu → hệ thống tự sinh và in ra màn hình.
SEED_EMAIL=quanly@giapha.test
SEED_PASSWORD=giapha-demo-2026

REDIS_URL=redis://localhost:6379

# Lưu file (dev: MinIO; production: Cloudflare R2)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=coinguon
R2_SECRET_ACCESS_KEY=coinguon-secret
R2_BUCKET=coinguon-media
R2_BACKUP_BUCKET=coinguon-backup

# Tên miền hệ thống: website dòng họ ở <slug>.APP_BASE_DOMAIN
APP_BASE_DOMAIN=coinguon.localhost
APP_NAME="Gia Phả Cội Nguồn"

# Phiên đăng nhập (sinh chuỗi ngẫu nhiên ≥ 32 ký tự: openssl rand -base64 48)
SESSION_SECRET=
CSRF_SECRET=
# Khoá mã hoá cột nhạy cảm (nhóm máu…), 32 byte base64
DATA_ENCRYPTION_KEY=

# Email (dev: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Gia Phả Cội Nguồn <no-reply@coinguon.localhost>"

# Đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chống spam form liên hệ (Cloudflare Turnstile; khoá test luôn cho qua)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

SENTRY_DSN=

# Ngày thống kê, âm lịch
TZ_BUSINESS=Asia/Ho_Chi_Minh
