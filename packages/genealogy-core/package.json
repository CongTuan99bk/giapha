{
  "name": "@coinguon/genealogy-core",
  "version": "0.1.0",
  "private": true,
  "description": "Logic phả hệ thuần TypeScript: chỉ mục cây, kiểm tra hợp lệ, đời/chi, xưng hô, bố cục phả đồ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  }
}
