{
  "name": "@coinguon/lunar-vn",
  "version": "0.1.0",
  "private": true,
  "description": "Âm lịch Việt Nam (UTC+7) và tính ngày giỗ — thuật toán thiên văn công bố bởi Hồ Ngọc Đức",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  }
}
