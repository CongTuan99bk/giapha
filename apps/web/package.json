{
  "name": "@coinguon/web",
  "version": "0.1.0",
  "private": true,
  "description": "Giao diện web Gia Phả Cội Nguồn (Next.js)",
  "type": "module",
  "scripts": {
    "sync-help": "node scripts/sync-help.mjs",
    "predev": "node scripts/sync-help.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/sync-help.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "node scripts/sync-help.mjs && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@coinguon/lunar-vn": "workspace:*",
    "@coinguon/schemas": "workspace:*",
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.2"
  }
}
