{
  "name": "@coinguon/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Gia Phả Cội Nguồn (NestJS)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:types": "kysely-codegen --url \"$DATABASE_URL\" --out-file src/db/generated.ts --camel-case=false",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js"
  },
  "dependencies": {
    "@coinguon/genealogy-core": "workspace:*",
    "@coinguon/lunar-vn": "workspace:*",
    "@coinguon/schemas": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
}
