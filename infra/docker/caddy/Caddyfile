# Dùng khi có tên miền trỏ về máy chủ (VPS, Oracle Cloud): Caddy tự lấy chứng chỉ HTTPS (Let's Encrypt).
# Chưa có tên miền: dùng DOMAIN=<IP-dạng-gạch-nối>.sslip.io, vd. 140-238-1-2.sslip.io
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	# API đi thẳng tới NestJS, không vòng qua Next → đỡ một chặng khi đông người dùng
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
